# --- Public client config (safe to expose; RTDB rules gate writes) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://jeezyplayground-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jeezyplayground
# Comma-separated Google accounts allowed past the sign-in gate.
NEXT_PUBLIC_AUTHORIZED_EMAILS=onesixty345@gmail.com

# --- Server-only (Vercel env vars, NEVER committed, NEVER NEXT_PUBLIC_) ---
FIREBASE_DATABASE_URL=https://jeezyplayground-default-rtdb.firebaseio.com
# Service-account JSON for server routes (Phase 2). Prefer a dedicated
# least-privilege account; never reuse a broad admin key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Modal backfill endpoint + shared secret (Phase 2).
MODAL_BACKFILL_URL=
MODAL_BACKFILL_SECRET=
